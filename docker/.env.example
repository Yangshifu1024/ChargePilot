# ChargePilot 生产环境变量（复制为 .env 后填写；清单与 platform::config 冻结一致）
# --- 编排内部 ---
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# --- 应用核心 ---
JWT_SECRET=change-me-32-bytes-minimum-0123456789abcdef
PAID_START_TIMEOUT_SECS=300
# --- 引导账号（首次启动创建管理员） ---
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
# --- 运行模式 ---
PAYMENT_MODE=development
LOGIN_MODE=development
# --- 微信凭据组（production 模式必填） ---
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL=
WECHAT_PRIVATE_KEY_PEM=
WECHAT_PLATFORM_CERTS=
WECHAT_NOTIFY_URL=
